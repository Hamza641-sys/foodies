# =========================================================================
# Foodies - Firebase Configuration
# =========================================================================
# These values go in js/firebase.js — NOT in a .env file (frontend project).
#
# HOW TO GET YOUR FIREBASE CONFIG:
# 1. Go to https://console.firebase.google.com
# 2. Open your project
# 3. Click gear icon → Project Settings
# 4. Scroll to "Your apps" → your web app (</>)
# 5. Copy firebaseConfig and paste into js/firebase.js
#
# FIREBASE SERVICES TO ENABLE:
# - Authentication → Email/Password + Google providers
# - Firestore Database → Start in production mode
# - Hosting (for deployment)
#
# FIRESTORE SECURITY RULES (paste in Firebase Console → Firestore → Rules):
# -------------------------------------------------------------------------
# rules_version = '2';
# service cloud.firestore {
#   match /databases/{database}/documents {
#     // Public read for menu, chefs, gallery, reviews, offers, coupons, delivery

#     match /categories/{id} { allow read: if true; }
#     match /chefs/{id}      { allow read: if true; }
#     match /gallery/{id}    { allow read: if true; }
#     match /reviews/{id}    { allow read: if true; allow write: if true; }
#     match /offers/{id}     { allow read: if true; }
#     match /coupons/{id}    { allow read: if true; }
#     match /deliveryZones/{id} { allow read: if true; }
#     // Orders - users can write, admin can read all
#     match /orders/{id}     { allow read, write: if request.auth != null; allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Manager']; }
#     // Reservations
#     match /reservations/{id} { allow read, write: if request.auth != null; }
#     // User profiles
#     match /users/{uid}     { allow read, write: if request.auth != null && request.auth.uid == uid; allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Manager']; }
#     // Contacts (public write)
#     match /contacts/{id}   { allow write: if true; allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
#   }
# }
# -------------------------------------------------------------------------
#
# ADMIN USER SETUP:
# After first deploy, register an account normally, then go to
# Firebase Console → Firestore → users collection → find your document
# → Edit role field to: admin
